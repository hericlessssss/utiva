# Servidor HTTP
PORT=3000
HOST=0.0.0.0

# Postgres (local via Docker Compose: db em 127.0.0.1:5433)
DATABASE_URL=postgresql://utiva:utiva@127.0.0.1:5433/utiva

# E-mail (Resend) — obrigatórios para subir a app
RESEND_API_KEY=
MAIL_FROM=utiva@seu-dominio.com
MAIL_TO=voce@exemplo.com

# Login com Google (OIDC) — Fase 2. Ativa as rotas /auth/* quando GOOGLE_CLIENT_ID está presente.
# Client ID e Secret vêm do Console: APIs & Services → Credentials → OAuth 2.0 Client (Web).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Precisa bater exatamente com um "Authorized redirect URI" do client no Console.
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# Assina os cookies de sessão/estado. Gere um: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
# Para onde mandar o browser depois do login (default "/").
# POST_LOGIN_REDIRECT=/

# Opcionais
# CF_CLEARANCE=            # cookie do Cloudflare, se precisar
# SCRAPE_CRON=*/5 * * * *  # cadência do scraper (default 5 min)
# SPRITE_CACHE_DIR=.sprite-cache  # cache dos sprites do bazar (ADR 10)

# Frontend: pasta do build do web/ para a API servir na mesma origem (vazio = só API).
# WEB_DIST=web/dist
