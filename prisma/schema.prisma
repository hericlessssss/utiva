// Schema do Utiva — fonte da verdade do schema da aplicação (§6 do planejamento).
// Escopo atual: fluxo A (detecção de char novo). watched_auction + notification
// entram com o fluxo B (lembretes de fim). pg-boss mantém as próprias tabelas.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuctionStatus {
  active
  finished
  cancelled
}

/// Conta de usuário autenticada via Google (OIDC) — Fase 2 (multiusuário).
/// Identidade estável é o `google_sub` (o `email` pode mudar na conta Google).
model User {
  id        String    @id @default(uuid()) @db.Uuid
  googleSub String    @unique @map("google_sub")
  email     String
  name      String?
  picture   String?
  /// Double opt-in (Fase 4): quando o usuário confirmou o e-mail. `null` = pendente → não
  /// recebe alertas. Resetado pra null quando o e-mail da conta Google muda.
  emailOptInAt DateTime? @map("email_opt_in_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  sessions          Session[]
  watchFilters      WatchFilter[]
  watchedAuctions   WatchedAuction[]
  emailVerifications EmailVerification[]
  emailEvents       EmailEvent[]

  @@map("user")
}

/// Token de confirmação de e-mail (double opt-in, Fase 4). Mesmo padrão da Session: a PK é o
/// SHA-256 (hex) do token cru; o link carrega o token cru. `email` amarra o token ao endereço
/// que ele confirma (se o e-mail do Google mudar, um token antigo não vale pro novo).
model EmailVerification {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  email     String
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification")
}

/// Registro de e-mail enviado, para o rate-limit por usuário (Fase 4). `type`: `alert`
/// (conta no teto) ou `limit` (aviso de teto atingido, deduplicado por janela).
model EmailEvent {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  type      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("email_event")
}

/// Sessão de login. A PK é o SHA-256 (hex) do token de sessão; o cookie carrega o
/// token cru. Assim um vazamento de leitura do banco não revela cookies utilizáveis.
model Session {
  id        String   @id
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

/// Preset de busca do usuário — mapeia 1:1 os filtros do Char Bazaar (§5).
model WatchFilter {
  id        Int      @id @default(autoincrement())
  userId    String   @map("user_id") @db.Uuid
  world     String?
  pvpType   String?  @map("pvp_type")
  battleye  String?
  vocation  String?
  levelFrom Int?     @map("level_from")
  levelTo   Int?     @map("level_to")
  skillId   String?  @map("skill_id")
  skillFrom Int?     @map("skill_from")
  skillTo   Int?     @map("skill_to")
  search    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  matches AuctionMatch[]

  @@index([userId])
  @@map("watch_filter")
}

/// Snapshot de um leilão visto. PK é o auctionid do tibia.com.
model Auction {
  auctionId   Int           @id @map("auction_id")
  charName    String        @map("char_name")
  world       String
  vocation    String
  sex         String
  level       Int
  startAt     DateTime?     @map("start_at") @db.Timestamptz
  endAt       DateTime      @map("end_at") @db.Timestamptz
  minBid      Int?          @map("min_bid")
  currentBid  Int?          @map("current_bid")
  battleye    String?
  pvpType     String?       @map("pvp_type")
  flags       Json?
  attributes  Json?
  /// Sprite do outfit exibido no card da lista (stem do GIF, ex.: "1875_3"); vem da fase 1 (ADR 10).
  outfit       String?      @map("outfit")
  /// Itens que o vendedor escolheu exibir no card (array de {name,count,sprite}); vem da fase 1.
  displayItems Json?        @map("display_items")
  status      AuctionStatus @default(active)
  firstSeenAt DateTime      @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz

  matches AuctionMatch[]
  watched WatchedAuction[]

  @@index([status, endAt])
  @@map("auction")
}

/// Leilão que um usuário marcou para acompanhar (toggle) — dispara os lembretes de fim (§7-B).
/// PK composta (user_id, auction_id): vários usuários podem acompanhar o mesmo leilão.
model WatchedAuction {
  userId    String   @map("user_id") @db.Uuid
  auctionId Int      @map("auction_id")
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  auction Auction @relation(fields: [auctionId], references: [auctionId], onDelete: Cascade)

  @@id([userId, auctionId])
  @@index([auctionId])
  @@map("watched_auction")
}

/// Liga um leilão ao watch_filter que o capturou (para saber por que alertou).
model AuctionMatch {
  id            Int      @id @default(autoincrement())
  auctionId     Int      @map("auction_id")
  watchFilterId Int      @map("watch_filter_id")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  auction     Auction     @relation(fields: [auctionId], references: [auctionId], onDelete: Cascade)
  watchFilter WatchFilter @relation(fields: [watchFilterId], references: [id], onDelete: Cascade)

  @@unique([auctionId, watchFilterId])
  @@index([watchFilterId])
  @@map("auction_match")
}
