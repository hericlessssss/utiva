# Envs de produção (Fase 6). NÃO comitar valores reais — estes ficam nos GitHub Secrets
# e o deploy (Actions) escreve o .env no VM a cada release. Este arquivo é só referência.
#
# DATABASE_URL não entra aqui: o compose de prod a monta de POSTGRES_PASSWORD
# (postgresql://utiva:${POSTGRES_PASSWORD}@db:5432/utiva).

# Domínio público servido pelo Caddy (sslip.io derivado do IP estático, ex.: 34-8-130-1.sslip.io)
SITE_ADDRESS=

# Senha do Postgres no container (também compõe a DATABASE_URL)
POSTGRES_PASSWORD=

# E-mail (Resend) — MAIL_FROM precisa de domínio verificado no Resend p/ enviar a terceiros
RESEND_API_KEY=
MAIL_FROM=
MAIL_TO=

# Login Google (OIDC). OAUTH_REDIRECT_URI = https://<SITE_ADDRESS>/auth/callback
# (precisa estar cadastrado no OAuth Client do Console). secureCookies liga sozinho em https.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=
# Assina os cookies de sessão/estado. Gere: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=
